   <!-- Foot contact points (at sole center, oriented world-up at the default flat-foot pose):
        fix feet_phase height bias & feet_ori non-semantic frame. Attached to foot_2/foot
        (the most distal foot link, below both ankle_pitch and ankle_roll) so they track both ankle joints. -->
   <link name="left_foot_contact_point">
      <inertial>
         <mass value="0.001"/>
         <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
